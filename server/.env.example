# Database URL: defaults to SQLite for zero-configuration, or use MySQL / PostgreSQL
# SQLite (default):
DATABASE_URL=sqlite:///./medilens.db
# MySQL example:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/medilens
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/medilens

# JWT Secret Key for token signing (generate a long random string in production)
JWT_SECRET=replace_with_a_secure_random_string_in_production

# Optional: LLM API keys (if left blank, built-in offline clinical intelligence engine is used)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: Path to Tesseract OCR executable (auto-detected if installed in PATH or standard paths)
# TESSERACT_CMD=/usr/bin/tesseract
