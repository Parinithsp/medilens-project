# Backend API Base URL
# In local development with Vite proxy, leave empty or use /api
# In production (Netlify, Vercel, etc.), set this to your live backend domain URL:
# Example: VITE_API_URL=https://medilens-api.onrender.com/api
VITE_API_URL=

# Firebase Authentication Configuration
# Obtain these values from Firebase Console > Project Settings > General > Your apps > Web app (</>)
# Also make sure "Google" is enabled in Firebase Console > Authentication > Sign-in method
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
